{
  "name": "svg-editor-cli",
  "version": "1.0.0",
  "private": true,
  "description": "A transactional, object-oriented SVG editor for Lab1 Phase 1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "plugins/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "npm run build --silent && node dist/src/bootstrap/main.js",
    "test": "npm run build --silent && node --test dist/test/*.test.js",
    "test:coverage": "npm run build --silent && node --experimental-test-coverage --test dist/test/*.test.js",
    "build:packages": "tsc -b tsconfig.build.json",
    "test:packages": "npm run build:packages && npm test --workspaces --if-present",
    "verify:visual": "npm run build --silent && node scripts/verify-visual.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run check:docs && npm test && npm run build:packages && npm run test:packages && node scripts/check-architecture.mjs",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
