{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "composite": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": [
    "index.ts",
    "domain/**/*.ts",
    "extensions/**/*.ts",
    "ports/**/*.ts",
    "events/**/*.ts",
    "services/**/*.ts",
    "presentation/**/*.ts",
    "testing/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
