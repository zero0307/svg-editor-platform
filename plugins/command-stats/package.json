{
  "name": "@svgframe/command-stats",
  "version": "0.0.0",
  "private": true,
  "description": "Independently toggleable stats command plugin for SVG Editor Platform",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "svgframe": {
    "contributes": {
      "commands": [
        "stats"
      ]
    }
  },
  "scripts": {
    "build": "tsc -b .",
    "test": "npm run build --silent && node --test \"dist/test/*.test.js\""
  },
  "dependencies": {
    "@svgframe/core": "*"
  }
}
