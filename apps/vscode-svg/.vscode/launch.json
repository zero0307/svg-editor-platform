{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run SVG extension (Extension Development Host)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "${workspaceFolder}/examples"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"]
    }
  ]
}
