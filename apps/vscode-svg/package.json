{
  "name": "vscode-svg",
  "displayName": "SVGFrame SVG",
  "description": "Explorer decoration and native Outline for SVG documents.",
  "publisher": "svgframe",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "categories": [
    "Other"
  ],
  "engines": {
    "vscode": "^1.143.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/zero0307/svg-editor-platform.git",
    "directory": "apps/vscode-svg"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.mjs",
    "test": "npm run build --silent && node --test \"dist/test/*.test.js\"",
    "package": "npm run build --silent && vsce package --no-dependencies --out dist/svgframe.vscode-svg.vsix"
  },
  "dependencies": {
    "@svgframe/svg-xml": "*"
  },
  "devDependencies": {
    "@types/vscode": "1.140.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2"
  }
}
