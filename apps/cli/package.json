{
  "name": "@svgframe/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Command-line composition roots and REPL for SVG Editor Platform",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b .",
    "test": "npm run build --silent && tsc -p tsconfig.test.json && node --test \"dist/test/*.test.js\""
  },
  "dependencies": {
    "@svgframe/builtins": "*",
    "@svgframe/command-dir": "*",
    "@svgframe/command-stats": "*",
    "@svgframe/core": "*",
    "@svgframe/host": "*",
    "@svgframe/shape-box": "*",
    "@svgframe/svg-xml": "*"
  }
}
