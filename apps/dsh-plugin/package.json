{
  "name": "dsh-svg-editor",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Inspect SVG documents and create editable flowcharts in DeepSeek Harness",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "main": "./dist/src/index.js",
  "files": [
    "dist/src/*.js",
    "dist/src/session.cjs",
    "cordis.patch.yml",
    "xmldom-LICENSE"
  ],
  "engines": {
    "dsh": "0.2.2-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@svgframe/core": "0.1.0",
    "esbuild": "0.25.12",
    "@deepseek-ai/dsh-fs": "0.2.2-rc.5",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.2-rc.5",
    "@deepseek-ai/dsh-working-directory": "0.2.2-rc.5"
  },
  "scripts": {
    "bundle": "esbuild ../../src/bootstrap/Phase1EditorSession.ts --bundle --platform=node --format=cjs --outfile=dist/src/session.cjs",
    "build": "tsc -b && npm run bundle --silent",
    "test": "npm run build --silent && node --test dist/test/*.test.js",
    "prepack": "npm run build"
  }
}
