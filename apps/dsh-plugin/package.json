{
  "name": "@svgframe/dsh-plugin",
  "version": "0.2.0",
  "private": true,
  "description": "DSH tools for SVG inspection and flowchart creation, bundled for standalone installation.",
  "type": "module",
  "main": "./dist/plugin.js",
  "exports": {
    ".": "./dist/plugin.js"
  },
  "files": [
    "dist/plugin.js",
    "cordis.patch.yml",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.mjs",
    "test": "npm run build --silent && node --test \"dist/test/*.test.js\""
  },
  "devDependencies": {
    "@svgframe/builtins": "*",
    "@svgframe/core": "*",
    "@svgframe/svg-xml": "*",
    "esbuild": "0.28.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
