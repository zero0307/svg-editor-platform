    {
      "from": "src/bootstrap",
      "to": "apps/cli",
      "kind": "directory",
      "fromCategory": "assembly",
      "toCategory": "assembly",
      "note": "组合根迁移，A/B 两个入口共用安装事务"
    },
    {
      "from": "src/infrastructure/XmlSvgCodec.ts",
